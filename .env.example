# Copy to .env and fill in. Local dev works with the defaults below (SQLite +
# local-disk storage + in-process queue) — no external services required.

# --- Database (Section 6) ---
# Local dev: SQLite. Production: a Neon/Supabase postgresql:// URL (also switch
# the datasource provider in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# --- Storage (Section 6 StorageProvider) ---
STORAGE_PROVIDER="local"   # "local" | "r2"
STORAGE_DIR="./.storage"   # local-disk root; ignored for r2

# --- Queue (Section 6 BullMQ / Upstash) ---
# Empty = in-process dev queue (no Redis). Set to an Upstash rediss:// URL for BullMQ.
REDIS_URL=""

# --- App ---
APP_URL="http://localhost:3000"
