# Copy to .env and fill in. Local dev works with the defaults below (SQLite +
# local-disk storage + in-process queue) — no external services required.

# --- Database (Section 6) ---
# Local dev: SQLite. Production: a Neon/Supabase postgresql:// URL (also switch
# the datasource provider in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# --- Storage (Section 6 StorageProvider) ---
STORAGE_PROVIDER="local"   # "local" | "r2"
STORAGE_DIR="./.storage"   # local-disk root; ignored for r2

# --- Queue (Section 6 BullMQ / Upstash) ---
# Empty = in-process dev queue (no Redis). Set to an Upstash rediss:// URL for BullMQ.
REDIS_URL=""

# --- App ---
APP_URL="http://localhost:3000"

# --- Auth (Section 6.4, Auth.js 5 / JWT sessions) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
# Auth.js needs its own base URL in some deploys; mirror APP_URL locally.
AUTH_URL="http://localhost:3000"

# --- Mail (Section 6.4 password reset, MailProvider) ---
# "console" = log the reset link to the server console (local dev, no SMTP).
# "smtp" = send real mail (set SMTP_* below) before public launch.
MAIL_PROVIDER="console"
MAIL_FROM="Zenfyle <no-reply@zenfyle.local>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# --- Rate limiting (Section 13.4, RateLimiter) ---
# "db" = count usage_events in the database (local dev, no Redis).
# "redis" = Upstash/Redis counter (set REDIS_URL) for production scale.
RATE_LIMITER="db"
