# =============================================================================
# Zenfyle environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` (local dev) or paste into Railway service variables
# (production) and fill in the values.
#
# IMPORTANT (Railway / similar platforms): build-time env vars are NOT available
# during `npm install` / `npm run build` — they are injected only at *runtime*
# once the service starts. The codebase is built to tolerate that (prisma.config.ts
# omits the datasource block when DATABASE_URL is unset, lib/db.ts creates the
# Prisma client lazily, etc.), so you can leave these blank/empty during first
# deploy and fill them in after the build succeeds. Review notes below for what's
# REQUIRED.
# =============================================================================

# --- Database (REQUIRED in production) ---------------------------------------
# The source of truth: users, jobs, usage events, waitlist emails.
# Postgres is used EVERYWHERE (dev and prod) — the schema provider is
# "postgresql" and lib/db.ts always uses the @prisma/adapter-pg adapter.
#   Local dev  : point it at your Supabase/Neon Postgres (same as prod, or a
#                dedicated dev instance if you prefer).
#   Production : a Postgres connection string (Railway Postgres, Neon, Supabase).
# URL-encode any special characters in the password: @ -> %40, # -> %23, and
# avoid $, &, etc. or percent-encode them too.
# For Supabase use the SESSION POOLER host (aws-0-<region>.pooler.supabase.com,
# port 5432) — the direct db.<ref>.supabase.co host is IPv6-only and unreachable
# from Railway. Append ?sslmode=no-verify (pooler cert is self-signed; TLS stays
# on). Keep sslmode=require for Neon/Railway Postgres.
# Format: postgresql://user:PASSWORD@host:5432/dbname?sslmode=no-verify
DATABASE_URL="postgresql://postgres:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# --- Prisma CLI update-check (optional) --------------------------------------
# Prisma phones home to "checkpoint" on every CLI run and prints an
# "Update available" banner (e.g. 7.8.0 -> 8.0.0-rc.14). It's informational —
# do NOT upgrade to release candidates in production. Disable the check:
CHECKPOINT_DISABLE=1
# Alternative that only hides the banner (keeps the check enabled):
# PRISMA_HIDE_UPDATE_MESSAGE=true

# --- Storage (Section 6 StorageProvider) -------------------------------------
# Which backend stores uploaded files / job outputs.
# "local"    = filesystem under STORAGE_DIR. Works in production only if the
#              process has a PERSISTENT volume mounted there (ephemeral disks
#              lose files on redeploy) — fine for local dev/testing.
# "supabase" = Supabase Storage (production). Bucket must be CREATED BY HAND in
#              the Supabase dashboard and kept PRIVATE (signed URLs only exist
#              for private buckets). Uses the service-role key server-side.
#              Set the same vars on the web service AND the worker service.
STORAGE_PROVIDER="supabase"
STORAGE_DIR="./.storage"   # local-disk root only; ignored for supabase

# --- Supabase Storage (required only when STORAGE_PROVIDER="supabase") --------
# From Supabase Dashboard → Settings → API:
#   SUPABASE_URL             — project URL, e.g. https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY — the service_role secret (sb_secret_... / eyJ...).
#                               Server-side only; lib/storage is never imported
#                               by client code, so this key never reaches the
#                               browser bundle.
# The bucket name below must exist already (Dashboard → Storage → New bucket,
# lowercase alphanumeric + hyphens, NO underscores/spaces) and be PRIVATE.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="zenfyle"

# Future R2 settings (store these now, wire up when the R2Provider lands):
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="zenfyle"
# R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# --- Queue (REQUIRED in production if you run the separate worker) ------------
# The job conveyor belt: hands PDF jobs from the web app to the worker process.
#   ""        = in-process dev queue — jobs run inside the Next.js server
#               (local dev only; NOT for production).
#   rediss:// = BullMQ production path. Uses a Redis provider (Railway Redis,
#               Upstash). You must ALSO run `npm run worker` in its own process
#               with the same REDIS_URL — otherwise jobs queue forever.
#               Production without REDIS_URL now fails loudly at enqueue time.
REDIS_URL=""

# --- App ----------------------------------------------------------------
# Public URLs your deployment is reachable at (no trailing slash).
#   APP_URL            — used to build signed download URLs and password-reset
#                        links. MUST be the public domain in production.
#   NEXT_PUBLIC_SITE_URL — canonical site URL for metadataBase, sitemap.xml and
#                        robots.txt. Baked into the client bundle at BUILD time,
#                        so set it in the build environment too.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth (REQUIRED: AUTH_SECRET) — Auth.js 5 / JWT sessions -----------
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production — must be a long random value, never the placeholder.
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
# Needed when behind a proxy/load balancer (Railway, Vercel) so Auth.js trusts
# the forwarded Host header.
AUTH_TRUST_HOST="true"
# Auth.js base URL; mirror APP_URL.
AUTH_URL="http://localhost:3000"

# --- Mail (Section 6.4 password reset) ---------------------------------------
# "console" = log reset links to the server console (local dev, no SMTP).
# "smtp"    = send real mail via nodemailer — REQUIRES SMTP_HOST/USER/PASS.
# Production recommendation: Gmail works for low-volume tests (~500/day), but
# for real launches use a transactional provider (Resend/Postmark/SES) behind
# the same MailProvider interface (see lib/server/mail/smtp.ts).
MAIL_PROVIDER="console"
MAIL_FROM="Zenfyle <no-reply@zenfyle.local>"
# --- Required only when MAIL_PROVIDER="smtp": ---
SMTP_HOST=""
SMTP_PORT="587"          # 587 = STARTTLS; 465 = implicit TLS
SMTP_USER=""
SMTP_PASS=""
# For Gmail: SMTP_PASS must be a 16-char App Password (not your normal password).
# Generate at https://myaccount.google.com/apppasswords — requires 2-Step Verification.

# --- Rate limiting (Section 13.4, RateLimiter) -------------------------------
# "db"    = count usage_events in the database (default; works everywhere).
# "redis" = Upstash/Redis counter — NOT yet implemented (stub in
#           lib/server/rate-limit/index.ts). Keep "db" until it lands.
RATE_LIMITER="db"

# --- Security (REQUIRED in production) ---------------------------------------
# Salt for hashing anonymous IPs (rate limits, concurrency guard, job ownership).
# Any long random string; generate with the same openssl/node command above.
# Change it in production to invalidate old anonymous job history.
IP_HASH_SALT="zenfyle-dev-salt"